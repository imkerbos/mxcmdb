# ============================================
# MXCMDB 生产环境配置
# 复制此文件并修改为实际值，切勿提交到版本控制
# ============================================

# ---- 服务 ----
MXCMDB_SERVER_PORT=10030
MXCMDB_SERVER_MODE=release

# ---- PostgreSQL ----
MXCMDB_DB_HOST=postgres
MXCMDB_DB_PORT=5432
MXCMDB_DB_USER=mxcmdb
MXCMDB_DB_PASSWORD=change-me-in-production
MXCMDB_DB_NAME=mxcmdb
MXCMDB_DB_SSLMODE=disable

# ---- Redis ----
MXCMDB_REDIS_HOST=redis
MXCMDB_REDIS_PORT=6379
MXCMDB_REDIS_PASSWORD=
MXCMDB_REDIS_DB=0

# ---- JWT ----
MXCMDB_JWT_SECRET=change-me-use-a-random-64-char-string
MXCMDB_JWT_ACCESS_EXPIRE=7200
MXCMDB_JWT_REFRESH_EXPIRE=604800

# ---- 加密 ----
MXCMDB_ENCRYPTION_KEY=change-me-use-a-random-64-char-string

# ---- 日志 ----
MXCMDB_LOG_LEVEL=info
MXCMDB_LOG_FORMAT=json
